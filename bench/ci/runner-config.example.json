{
  "schema_version": 1,
  "activation_ready": false,
  "device": "REPLACE_WITH_REVIEWED_DEVICE_SLOT",
  "platform": "REPLACE_WITH_linux_OR_darwin",
  "lock_path": "/operator/provided/existing-device.lock",
  "stop_path": "/operator/provided/STOP",
  "workspace_root": "/operator/provided/ci-workspaces",
  "min_free_bytes": 10737418240,
  "max_workspace_bytes": 53687091200,
  "stage_policy": {
    "platform": "REPLACE_WITH_linux_OR_darwin",
    "lock_path": "/operator/provided/existing-device.lock",
    "stop_path": "/operator/provided/STOP",
    "memory_budget_bytes": 4294967296,
    "host_reserve_bytes": 3221225472,
    "minimum_memlock_bytes": 0,
    "max_compressor_growth_bytes": 0,
    "max_swap_growth_bytes": 0,
    "runtime_seconds": 7200,
    "cleanup_seconds": 30
  },
  "build": {
    "argv": [
      "{python}",
      "{control}/bench/ci/build.py",
      "--config",
      "{config}",
      "--source",
      "{source}",
      "--build",
      "{build}",
      "--revision",
      "{revision}",
      "--receipt",
      "{receipt}"
    ],
    "timeout_s": 7200,
    "cmake": "/operator/provided/cmake",
    "cmake_flags": [
      "-DCMAKE_BUILD_TYPE=Release",
      "-DLLAMA_BUILD_TESTS=ON",
      "REPLACE_WITH_REVIEWED_NATIVE_BACKEND_AND_TOOLCHAIN_FLAGS"
    ],
    "targets": [
      "llama-server",
      "REPLACE_WITH_COMPLETE_NUMERICAL_AND_LIFECYCLE_TARGETS"
    ],
    "jobs": 2,
    "binary_relative": "bin/llama-server",
    "image_relatives": [
      "REPLACE_WITH_COMPLETE_PROJECT_IMAGE_PATHS"
    ],
    "template_relatives": {
      "tiny": "REPLACE_WITH_REVIEWED_REPO_TEMPLATE_PATH",
      "deepseek": "REPLACE_WITH_REVIEWED_REPO_TEMPLATE_PATH",
      "muse": "REPLACE_WITH_REVIEWED_REPO_TEMPLATE_PATH"
    }
  },
  "validation": {
    "argv": [
      "/operator/provided/ctest",
      "--test-dir",
      "{build}",
      "--output-on-failure",
      "--no-tests=error",
      "--output-junit",
      "{results}",
      "-R",
      "REPLACE_WITH_ANCHORED_COMPLETE_REVIEWED_SET"
    ],
    "timeout_s": 1800,
    "baseline": {
      "tests": {
        "REPLACE_NUMERICAL": {
          "expect": "passed",
          "kind": "numerical"
        },
        "REPLACE_LIFECYCLE": {
          "expect": "passed",
          "kind": "lifecycle"
        }
      }
    }
  },
  "profiles": {
    "tiny": {
      "path": "/operator/provided/tiny-typed-profile.json",
      "sha256": "REPLACE_WITH_VERIFIED_WHOLE_PROFILE_SHA256"
    },
    "deepseek": {
      "path": "/operator/provided/deepseek-typed-profile.json",
      "sha256": "REPLACE_WITH_VERIFIED_WHOLE_PROFILE_SHA256"
    },
    "muse": {
      "path": "/operator/provided/muse-typed-profile.json",
      "sha256": "REPLACE_WITH_VERIFIED_WHOLE_PROFILE_SHA256"
    }
  },
  "request_timeout_s": 1800,
  "arm_timeout_s": 3600,
  "isolation": {
    "backend": "unprovisioned",
    "broker_path": "/opt/inferssd-broker/broker",
    "broker_sha256": "REPLACE_WITH_REVIEWED_ROOT_OWNED_BROKER_SHA256",
    "proof_path": "/opt/inferssd-broker/isolation-proof.json",
    "proof_sha256": "REPLACE_WITH_ACTUAL_NEGATIVE_GATE_RECEIPT_SHA256"
  }
}
