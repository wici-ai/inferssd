// key, kind, min, max, default literal, unit, producer, scope (platform bits), description
SSD_SETTING("expert.source", paths, 0, 0, "[]", "path", "plan", scope_all, "Expert index source paths in declared order")
SSD_SETTING("cpu.io_cpus", cpus, 0, 2147483647, "", "CPU ID", "plan", scope_all, "Ordered unique CPU IDs for I/O participants")
SSD_SETTING("cpu.decode_participants", integer, 0, 255, "0", "compute participants", "plan", scope_all, "Decode compute participants; zero selects the measured/default policy")
SSD_SETTING("prefetch.depth", integer, 0, 64, "2", "predicted experts", "plan", scope_all, "Next-layer predicted experts, not a layer count or Mac read window")
SSD_SETTING("place.costs", costs, 0, 1000000, "", "named us and GB/s terms", "plan", scope_all, "Measured placement cost terms; omitted terms retain calibrated priors")
SSD_SETTING("prefill.cpu_max_tokens", integer, 0, 4294967295, "4294967295", "tokens", "plan", scope_linux, "Largest CPU prefill ubatch; transitional v0.1 setting")
SSD_SETTING("vram.budget", budget, 0, 68719476736, "auto", "bytes", "plan", scope_linux, "Expert VRAM byte budget or auto")
SSD_SETTING("vram.max_slots", integer, 0, 4294967295, "0", "slots", "plan", scope_linux, "Maximum expert slots; zero leaves the resource-derived bound")
SSD_SETTING("vram.reserve_mib", integer, 0, 8192, "0", "MiB", "launch", scope_linux, "CUDA allocation reserve in MiB")
SSD_SETTING("vram.margin_mib", integer, 64, 8192, "64", "MiB", "launch", scope_linux, "Elastic safety margin in MiB, at least reserve plus 64")
SSD_SETTING("host.headroom_mib", integer, 0, 4294967295, "512", "MiB", "plan", scope_all, "Host safety headroom in MiB")
SSD_SETTING("host.budget_mib", integer, 0, 17592186044415, "0", "MiB", "plan", scope_darwin | scope_windows, "Host memory envelope in MiB against this process's own memory; zero derives it at startup")
SSD_SETTING("model.engram_prefetch", integer, 0, 1, "0", "boolean", "model", scope_all, "Read ahead DeepSeek Engram rows; changes I/O timing only")
SSD_SETTING("model.hc_fused", integer, 0, 1, "1", "boolean", "model", scope_all, "Use the fused hyper connection operations of DeepSeek-V4.1 and Qwen3.8-Flash-Next")
SSD_SETTING("model.kv_rotation_resident", integer, 0, 1, "1", "boolean", "model", scope_all, "Experimental resident indexer rotation; effective default on only for DeepSeek V4.1, off for all other architectures")
