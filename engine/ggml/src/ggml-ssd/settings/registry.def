// SPDX-License-Identifier: Apache-2.0
// key, kind, min, max, default literal, unit, producer, scope (platform bits), backend, description
// The scope names the platforms whose mechanisms a setting configures. The backend, when not empty, is the GPU backend
// whose expert tier the setting configures: an engine without that tier refuses the setting when it is set.
SSD_SETTING("expert.source", paths, 0, 0, "[]", "path", "plan", scope_all, "", "Expert index source paths in declared order")
SSD_SETTING("cpu.io_cpus", cpus, 0, 2147483647, "", "CPU ID", "plan", scope_all, "", "Ordered unique CPU IDs for I/O participants")
SSD_SETTING("cpu.decode_participants", integer, 0, 255, "0", "compute participants", "plan", scope_all, "", "Decode compute participants; zero selects the measured/default policy")
SSD_SETTING("prefetch.depth", integer, 0, 64, "64", "predicted experts", "plan", scope_all, "", "Next-layer predicted experts the prefetch weighs, best first (0: none); it reads those whose reads pay")
SSD_SETTING("place.costs", costs, 0, 1000000, "", "named us and GB/s terms", "plan", scope_all, "", "Measured placement cost terms; omitted terms retain calibrated priors")
SSD_SETTING("prefill.lookahead", integer, 0, 1, "1", "boolean", "plan", scope_all, "", "Read the next layer's predicted SSD experts while the drive idles between grouped-prefill layers; changes I/O timing only")
SSD_SETTING("vram.budget", budget, 0, 68719476736, "auto", "bytes", "plan", scope_all, "", "GPU expert byte budget or auto; 0 keeps experts on the CPU")
SSD_SETTING("vram.max_slots", integer, 0, 4294967295, "0", "slots", "plan", scope_all, "CUDA", "Maximum expert slots; zero leaves the resource-derived bound")
SSD_SETTING("vram.reserve_mib", integer, 0, 8192, "0", "MiB", "launch", scope_all, "CUDA", "VRAM in MiB that prefill and decode leave free for other processes")
SSD_SETTING("host.headroom_mib", integer, 0, 4294967295, "512", "MiB", "plan", scope_all, "", "Host memory in MiB the expert caches leave free")
SSD_SETTING("host.budget_mib", integer, 0, 17592186044415, "0", "MiB", "plan", scope_darwin | scope_windows, "", "Host memory envelope in MiB against this process's own memory; zero leaves the machine's physical memory")
SSD_SETTING("model.engram_prefetch", integer, 0, 1, "0", "boolean", "model", scope_all, "", "Read ahead DeepSeek Engram rows; changes I/O timing only")
SSD_SETTING("model.hc_fused", integer, 0, 1, "1", "boolean", "model", scope_all, "", "Use the fused hyper connection operations of DeepSeek-V4.1 and Qwen3.8-Flash-Next")

// Explicit, identical expert-pack replicas for the opt-in multi-drive executor.
SSD_SETTING("expert.replicas", paths, 0, 0, "[]", "path", "plan", scope_linux, "", "EXPERIMENTAL: verified byte-identical replica indexes; empty disables range reads")
SSD_SETTING("io.range_max_experts", integer, 1, 8, "2", "experts", "plan", scope_linux, "", "Split reads only when demand I/O expert count is at most this bound")

SSD_SETTING("io.replica_policy", integer, 0, 3, "0", "policy", "plan", scope_linux, "", "EXPERIMENTAL: 0: range, 1: whole, 2: adaptive, 3: static replica routing")
SSD_SETTING("io.shared_pool", integer, 0, 1, "0", "policy", "plan", scope_linux, "", "EXPERIMENTAL: Share replica load accounting between demand and prefetch")
SSD_SETTING("io.split_prefetch", integer, 0, 1, "0", "policy", "plan", scope_linux, "", "EXPERIMENTAL: Allow aligned prefetch reads to split across replicas")
SSD_SETTING("io.force_async", integer, 0, 1, "0", "policy", "plan", scope_linux, "", "EXPERIMENTAL: Submit demand reads through bounded io_uring workers")
SSD_SETTING("prefetch.force_async", integer, 0, 1, "0", "policy", "plan", scope_linux, "", "EXPERIMENTAL: Submit shared-pool prefetch through bounded io_uring workers")
SSD_SETTING("io.replica_decode_only", integer, 0, 1, "0", "policy", "plan", scope_linux, "", "EXPERIMENTAL: Restrict replica routing to decode")
SSD_SETTING("io.replica_tail_aware", integer, 0, 1, "0", "policy", "plan", scope_linux, "", "EXPERIMENTAL: Penalize replica queues with delayed observed progress")
SSD_SETTING("cpu.l3_cpus", cpus, 0, 4095, "", "CPU ID", "plan", scope_linux, "", "EXPERIMENTAL: Ascending compute CPU list for L3-local scheduling; empty disables it")
SSD_SETTING("cpu.l3_local", integer, 0, 1, "1", "policy", "plan", scope_linux, "", "EXPERIMENTAL: Assign decode row chunks within shared-L3 groups")
SSD_SETTING("cpu.l3_up_rows", integer, 16, 128, "32", "policy", "plan", scope_linux, "", "EXPERIMENTAL: Up/gate rows per L3 scheduling chunk; multiple of 16")
SSD_SETTING("cpu.l3_down_rows", integer, 16, 128, "64", "policy", "plan", scope_linux, "", "EXPERIMENTAL: Down rows per L3 scheduling chunk; multiple of 16")
