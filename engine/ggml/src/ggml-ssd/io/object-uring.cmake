# Pure Linux io_uring transport; no backend, GPU or model dependency.
add_library(ggml-ssd-object-io STATIC object-uring.cpp object-uring.h)
set_target_properties(ggml-ssd-object-io PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_compile_features(ggml-ssd-object-io PUBLIC cxx_std_17)
target_include_directories(ggml-ssd-object-io PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/..")
if (CMAKE_SYSTEM_NAME STREQUAL "Linux")
    find_path(SSD_OBJECT_URING_INCLUDE liburing.h)
    find_library(SSD_OBJECT_URING_LIBRARY uring)
endif()
if (SSD_OBJECT_URING_INCLUDE AND SSD_OBJECT_URING_LIBRARY)
    target_include_directories(ggml-ssd-object-io PUBLIC "${SSD_OBJECT_URING_INCLUDE}")
    target_link_libraries(ggml-ssd-object-io PUBLIC "${SSD_OBJECT_URING_LIBRARY}")
else()
    target_compile_definitions(ggml-ssd-object-io PUBLIC GGML_MOE_DISABLE_LIBURING)
    if (GGML_CUDA_KIMI_VRAM_TIER)
        message(FATAL_ERROR "SSD CUDA transport requires Linux liburing")
    endif()
endif()
