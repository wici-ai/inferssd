set(ENV{GGML_BACKEND_PATH} "${BACKEND}")
unset(ENV{LLAMA_ARG_THREADS})

if(CASE STREQUAL "hyphen" OR CASE STREQUAL "underscore" OR CASE STREQUAL "environment")
    execute_process(COMMAND "${DRIVER}" schema-reference
        RESULT_VARIABLE reference_status OUTPUT_VARIABLE reference ERROR_VARIABLE reference_error)
    if(NOT reference_status EQUAL 0 OR NOT reference_error STREQUAL "")
        message(FATAL_ERROR "cannot read reference schema: ${reference_error}")
    endif()
    if(CASE STREQUAL "underscore")
        set(option --ssd_schema)
    else()
        set(option --ssd-schema)
    endif()
    if(CASE STREQUAL "environment")
        set(ENV{LLAMA_ARG_THREADS} "not-an-integer")
    endif()
    execute_process(COMMAND "${DRIVER}" "${option}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0 OR NOT output STREQUAL reference)
        message(FATAL_ERROR "standalone schema differs (${status}): ${error}")
    endif()
    if(error MATCHES "schema test backend initialized")
        message(FATAL_ERROR "standalone schema initialized a backend")
    endif()
elseif(CASE STREQUAL "model-value")
    execute_process(COMMAND "${DRIVER}" --model --ssd-schema
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0 OR NOT output STREQUAL "model=--ssd-schema\n")
        message(FATAL_ERROR "schema spelling was not kept as a model argument: ${error}")
    endif()
elseif(CASE STREQUAL "extra-argument")
    execute_process(COMMAND "${DRIVER}" --invalid-option --ssd-schema
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 1 OR NOT error MATCHES "error: invalid argument: --invalid-option")
        message(FATAL_ERROR "extra argument escaped ordinary validation (${status}): ${error}")
    endif()
elseif(CASE STREQUAL "trailing-options")
    execute_process(COMMAND "${DRIVER}" --ssd-schema --threads 1
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0 OR NOT output MATCHES "InferSSD settings v1")
        message(FATAL_ERROR "mixed schema invocation changed (${status}): ${error}")
    endif()
elseif(CASE STREQUAL "devices")
    execute_process(COMMAND "${DRIVER}" --list-devices
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT status EQUAL 0 OR NOT output MATCHES "Available devices:")
        message(FATAL_ERROR "ordinary device query failed (${status}): ${error}")
    endif()
else()
    message(FATAL_ERROR "unknown schema CLI test case: ${CASE}")
endif()

if(CASE STREQUAL "model-value" OR CASE STREQUAL "extra-argument" OR CASE STREQUAL "trailing-options" OR CASE STREQUAL "devices")
    if(NOT error MATCHES "schema test backend initialized")
        message(FATAL_ERROR "ordinary parser did not load the test backend: ${error}")
    endif()
endif()
