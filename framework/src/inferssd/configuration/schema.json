{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "InferSSD settings v1",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "expert.source": {
            "description": "Expert index source paths in declared order",
            "kind": "paths",
            "unit": "path",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-expert-source",
            "default_literal": "[]",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "default": []
        },
        "cpu.io_cpus": {
            "description": "Ordered unique CPU IDs for I/O participants",
            "kind": "cpus",
            "unit": "CPU ID",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-cpu-io-cpus",
            "default_literal": "",
            "type": "array",
            "uniqueItems": true,
            "maxItems": 65536,
            "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
            },
            "default": []
        },
        "cpu.decode_participants": {
            "description": "Decode compute participants; zero selects the measured/default policy",
            "kind": "integer",
            "unit": "compute participants",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-cpu-decode-participants",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "default": 0
        },
        "prefetch.depth": {
            "description": "Next-layer predicted experts the prefetch weighs, best first (0: none); it reads those whose reads pay",
            "kind": "integer",
            "unit": "predicted experts",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-prefetch-depth",
            "default_literal": "64",
            "type": "integer",
            "minimum": 0,
            "maximum": 64,
            "default": 64
        },
        "place.costs": {
            "description": "Measured placement cost terms; omitted terms retain calibrated priors",
            "kind": "costs",
            "unit": "named us and GB/s terms",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-place-costs",
            "default_literal": "",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cpu_fixed_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "cpu_route_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "drive_fixed_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "drive_gbps": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "gpu_fixed_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "gpu_host_fixed_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "gpu_host_route_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "gpu_route_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "gpu_token_us": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                },
                "link_gbps": {
                    "type": "number",
                    "maximum": 1000000,
                    "exclusiveMinimum": 0
                },
                "pageable_gbps": {
                    "type": "number",
                    "maximum": 1000000,
                    "minimum": 0
                }
            },
            "default": {}
        },
        "prefill.lookahead": {
            "description": "Read the next layer's predicted SSD experts while the drive idles between grouped-prefill layers; changes I/O timing only",
            "kind": "integer",
            "unit": "boolean",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-prefill-lookahead",
            "default_literal": "1",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 1
        },
        "vram.budget": {
            "description": "GPU expert byte budget or auto; 0 keeps experts on the CPU",
            "kind": "budget",
            "unit": "bytes",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-vram-budget",
            "default_literal": "auto",
            "oneOf": [
                {
                    "const": "auto"
                },
                {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 68719476736
                }
            ],
            "default": "auto"
        },
        "vram.max_slots": {
            "description": "Maximum expert slots; zero leaves the resource-derived bound",
            "kind": "integer",
            "unit": "slots",
            "producer": "plan",
            "scope": "all",
            "backend": "CUDA",
            "cli": "--ssd-vram-max-slots",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "default": 0
        },
        "vram.reserve_mib": {
            "description": "VRAM in MiB that prefill and decode leave free for other processes",
            "kind": "integer",
            "unit": "MiB",
            "producer": "launch",
            "scope": "all",
            "backend": "CUDA",
            "cli": "--ssd-vram-reserve-mib",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 8192,
            "default": 0
        },
        "host.headroom_mib": {
            "description": "Host memory in MiB the expert caches leave free",
            "kind": "integer",
            "unit": "MiB",
            "producer": "plan",
            "scope": "all",
            "cli": "--ssd-host-headroom-mib",
            "default_literal": "512",
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "default": 512
        },
        "host.budget_mib": {
            "description": "Host memory envelope in MiB against this process's own memory; zero leaves the machine's physical memory",
            "kind": "integer",
            "unit": "MiB",
            "producer": "plan",
            "scope": "darwin,windows",
            "cli": "--ssd-host-budget-mib",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 17592186044415,
            "default": 0
        },
        "model.engram_prefetch": {
            "description": "Read ahead DeepSeek Engram rows; changes I/O timing only",
            "kind": "integer",
            "unit": "boolean",
            "producer": "model",
            "scope": "all",
            "cli": "--ssd-model-engram-prefetch",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 0
        },
        "model.hc_fused": {
            "description": "Use the fused hyper connection operations of DeepSeek-V4.1 and Qwen3.8-Flash-Next",
            "kind": "integer",
            "unit": "boolean",
            "producer": "model",
            "scope": "all",
            "cli": "--ssd-model-hc-fused",
            "default_literal": "1",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 1
        },
        "expert.replicas": {
            "description": "EXPERIMENTAL: verified byte-identical replica indexes; empty disables range reads",
            "kind": "paths",
            "unit": "path",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-expert-replicas",
            "default_literal": "[]",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            },
            "default": []
        },
        "io.range_max_experts": {
            "description": "Split reads only when demand I/O expert count is at most this bound",
            "kind": "integer",
            "unit": "experts",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-io-range-max-experts",
            "default_literal": "2",
            "type": "integer",
            "minimum": 1,
            "maximum": 8,
            "default": 2
        },
        "io.replica_policy": {
            "description": "EXPERIMENTAL: 0: range, 1: whole, 2: adaptive, 3: static replica routing",
            "kind": "integer",
            "unit": "policy",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-io-replica-policy",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "default": 0
        },
        "io.shared_pool": {
            "description": "EXPERIMENTAL: Share replica load accounting between demand and prefetch",
            "kind": "integer",
            "unit": "policy",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-io-shared-pool",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 0
        },
        "io.split_prefetch": {
            "description": "EXPERIMENTAL: Allow aligned prefetch reads to split across replicas",
            "kind": "integer",
            "unit": "policy",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-io-split-prefetch",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 0
        },
        "io.force_async": {
            "description": "EXPERIMENTAL: Submit demand reads through bounded io_uring workers",
            "kind": "integer",
            "unit": "policy",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-io-force-async",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 0
        },
        "prefetch.force_async": {
            "description": "EXPERIMENTAL: Submit shared-pool prefetch through bounded io_uring workers",
            "kind": "integer",
            "unit": "policy",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-prefetch-force-async",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 0
        },
        "io.replica_decode_only": {
            "description": "EXPERIMENTAL: Restrict replica routing to decode",
            "kind": "integer",
            "unit": "policy",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-io-replica-decode-only",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 0
        },
        "io.replica_tail_aware": {
            "description": "EXPERIMENTAL: Penalize replica queues with delayed observed progress",
            "kind": "integer",
            "unit": "policy",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-io-replica-tail-aware",
            "default_literal": "0",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 0
        },
        "cpu.l3_cpus": {
            "description": "EXPERIMENTAL: Ascending compute CPU list for L3-local scheduling; empty disables it",
            "kind": "cpus",
            "unit": "CPU ID",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-cpu-l3-cpus",
            "default_literal": "",
            "type": "array",
            "uniqueItems": true,
            "maxItems": 65536,
            "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
            },
            "default": []
        },
        "cpu.l3_local": {
            "description": "EXPERIMENTAL: Assign decode row chunks within shared-L3 groups",
            "kind": "integer",
            "unit": "policy",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-cpu-l3-local",
            "default_literal": "1",
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "default": 1
        },
        "cpu.l3_up_rows": {
            "description": "EXPERIMENTAL: Up/gate rows per L3 scheduling chunk; multiple of 16",
            "kind": "integer",
            "unit": "policy",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-cpu-l3-up-rows",
            "default_literal": "32",
            "type": "integer",
            "minimum": 16,
            "maximum": 128,
            "default": 32
        },
        "cpu.l3_down_rows": {
            "description": "EXPERIMENTAL: Down rows per L3 scheduling chunk; multiple of 16",
            "kind": "integer",
            "unit": "policy",
            "producer": "plan",
            "scope": "linux",
            "cli": "--ssd-cpu-l3-down-rows",
            "default_literal": "64",
            "type": "integer",
            "minimum": 16,
            "maximum": 128,
            "default": 64
        }
    }
}
